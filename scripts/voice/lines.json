[
  {"id": "a01", "s": 5.2,  "v": "male",   "t": "没什么原因。就是……想讲给你听。"},
  {"id": "a02", "s": 10.4, "v": "male",   "t": "那天晚上在海边，太阳沉下去那会儿，我忽然想起一首诗。"},
  {"id": "a03", "s": 17.9, "v": "male",   "t": "上周末你发来晚霞，跟那天一模一样。"},
  {"id": "a04", "s": 22.9, "v": "male",   "t": "我才想起来，你是襄阳人。"},
  {"id": "a05", "s": 27.5, "v": "male",   "t": "那首诗，是郭襄写的。"},
  {"id": "a06", "s": 34.3, "v": "male",   "t": "郭襄的襄，就是襄阳的襄。那年她十六岁，一个人从襄阳跑出来。"},
  {"id": "a07", "s": 44.4, "v": "male",   "t": "家里没人信她能走这么远。"},
  {"id": "a08", "s": 48.9, "v": "male",   "t": "风陵渡只是黄河边的一个小渡口。她本来是要路过的。"},
  {"id": "a10", "s": 74.0, "v": "male",   "t": "放这场烟花的人，站在城里最高的地方，看了她一整夜。"},
  {"id": "a12", "s": 88.8, "v": "male",   "t": "往后的二十四年，让她自己讲。"},
  {"id": "b01", "s": 94.3,  "v": "female", "t": "后来我就背着剑出门了。"},
  {"id": "b02", "s": 101.0, "v": "female", "t": "一个渡口走到下一个渡口。走了很多年。"},
  {"id": "b03", "s": 108.6, "v": "female", "t": "我每到一个渡口都问，有没有一个只有一只袖子的人经过。"},
  {"id": "b05", "s": 124.6, "v": "female", "t": "我赶到的时候，雪已经把脚印盖住了。"},
  {"id": "b06", "s": 129.4, "v": "female", "t": "我每次都晚三天。"},
  {"id": "b07", "s": 143.3, "v": "female", "t": "我听见了。"},
  {"id": "b08a", "s": 150.2, "v": "female", "t": "三枚金针，我用掉了一枚。"},
  {"id": "b08b", "s": 157.6, "v": "female", "t": "那一枚，只求看一眼他的脸。"},
  {"id": "b09", "s": 163.2, "v": "female", "t": "十六岁出门，四十岁出家。中间二十四年，我没安过一个家。"},
  {"id": "b11", "s": 177.6, "v": "female", "t": "出家那天，我把金针夹进经书里，没烧掉。"},
  {"id": "b12", "s": 184.3, "v": "female", "t": "灯一挑亮，我就看见那年的火。"},
  {"id": "d01", "s": 239.0, "v": "male", "t": "晚霞还会有。到时候，我讲我们的。"}
]