[
 {
  "id": "m01",
  "start": 0.296,
  "end": 0.566,
  "text": "念念。"
 },
 {
  "id": "m02",
  "start": 1.506,
  "end": 6.366,
  "text": "那天我们在海边看落日，我就想把这个故事做给你。"
 },
 {
  "id": "m03",
  "start": 7.106,
  "end": 9.206,
  "text": "后来我真的开始做了。"
 },
 {
  "id": "m04",
  "start": 10.376,
  "end": 15.006,
  "text": "做到一半，你发我一张落日，说是你拍的。"
 },
 {
  "id": "m05",
  "start": 15.226,
  "end": 19.856,
  "text": "我盯着看了很久，半天没回你。"
 },
 {
  "id": "m06",
  "start": 20.986,
  "end": 22.656,
  "text": "太巧了。"
 },
 {
  "id": "m07",
  "start": 23.086,
  "end": 26.486,
  "text": "巧得我差点以为，你知道了。"
 },
 {
  "id": "m54",
  "start": 266.646,
  "end": 267.506,
  "text": "念念。"
 },
 {
  "id": "m55",
  "start": 268.426,
  "end": 270.726,
  "text": "郭襄的三枚金针，都用完了。"
 },
 {
  "id": "m56",
  "start": 271.326,
  "end": 274.026,
  "text": "第一枚，她看了他的脸。"
 },
 {
  "id": "m57",
  "start": 274.606,
  "end": 276.566,
  "text": "第二枚，她看了一夜烟花。"
 },
 {
  "id": "m58",
  "start": 277.196,
  "end": 280.456,
  "text": "第三枚，她让他活了下来。"
 },
 {
  "id": "m59",
  "start": 281.726,
  "end": 282.596,
  "text": "我没有金针。"
 },
 {
  "id": "m60",
  "start": 283.456,
  "end": 285.666,
  "text": "我只有以后的每一个落日。"
 },
 {
  "id": "m61",
  "start": 286.506,
  "end": 289.126,
  "text": "你回头，我就在。"
 },
 {
  "id": "m62",
  "start": 289.306,
  "end": 290.446,
  "text": "现在，你知道了。"
 }
]
